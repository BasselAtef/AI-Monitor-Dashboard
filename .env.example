# Copy to .env and fill in. The app refuses to start if any of these are
# missing, rather than serving everyone's data to anyone.

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID of type "Web application".
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly, including
# the trailing /auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the redirect URI registered in Google Cloud, including the scheme.
# Local:  http://localhost:5000/auth/google/callback
# Deployed: https://your-app.up.railway.app/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Signs the session cookie. Generate a fresh one, never reuse an example:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 1 once you have a real HTTPS domain, so the session cookie is never
# sent over plaintext HTTP. Leave at 0 for plain-HTTP local development.
SESSION_COOKIE_SECURE=0

# Database
# Leave DATABASE_URL unset to use the local SQLite file (monitor.db).
# On Railway, add a Postgres plugin and paste its connection string here; the
# app detects it and switches backends automatically. Nothing else changes.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional, only used when you run the app directly.
# Your own LLM key, for local experiments. The dashboard never needs it.
GROQ_API_KEY=
